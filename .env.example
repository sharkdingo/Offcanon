# OpenAI-compatible model provider (required for a real Agent run)
PICO_MODEL_BASE_URL=https://api.example.com/v1
PICO_MODEL_API_KEY=replace-with-a-local-secret
PICO_MODEL_NAME=provider-model-id

# Runtime data must stay outside every registered Git repository.
PICO_DATA_ROOT=D:/pico-data

# Optional durable profiles
SPRING_PROFILES_ACTIVE=mysql,redis
PICO_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/pico?serverTimezone=UTC
PICO_MYSQL_USERNAME=pico
PICO_MYSQL_PASSWORD=replace-with-a-local-secret
PICO_REDIS_HOST=127.0.0.1
PICO_REDIS_PORT=6379
