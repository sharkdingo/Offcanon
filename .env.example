# OpenAI-compatible model provider. The API key is required for a real Agent
# run; endpoint and model name are optional deployment defaults because users
# may provide them through Settings.
OFFCANON_MODEL_BASE_URL=https://api.example.com/v1
# Optional comma-separated additional provider base URLs.  Every listed URL
# receives the server-side OFFCANON_MODEL_API_KEY when selected in Settings.
OFFCANON_MODEL_ALLOWED_BASE_URLS=
OFFCANON_MODEL_API_KEY=replace-with-a-local-secret
OFFCANON_MODEL_NAME=provider-model-id

# Agent defaults and hard deployment ceilings. User Settings can only choose
# values within these ceilings.
OFFCANON_AGENT_MAX_STEPS=20
OFFCANON_AGENT_MAX_STEPS_CEILING=100
OFFCANON_AGENT_RUN_TIMEOUT_SECONDS=600
OFFCANON_AGENT_RUN_TIMEOUT_SECONDS_CEILING=86400
OFFCANON_AGENT_CONTEXT_LIMIT_CHARS=80000
OFFCANON_AGENT_CONTEXT_LIMIT_CHARS_CEILING=1000000

# Runtime data must stay outside every registered Git repository.
OFFCANON_DATA_ROOT=D:/Offcanon-data

# Optional durable profiles
SPRING_PROFILES_ACTIVE=mysql,redis
OFFCANON_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/offcanon?serverTimezone=UTC
OFFCANON_MYSQL_USERNAME=offcanon
OFFCANON_MYSQL_PASSWORD=replace-with-a-local-secret
OFFCANON_REDIS_HOST=127.0.0.1
OFFCANON_REDIS_PORT=6379
